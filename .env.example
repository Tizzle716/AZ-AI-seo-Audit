# Azure Function App API Base URL
REACT_APP_API_BASE_URL=https://seoaudit-functions.azurewebsites.net

# Environment
REACT_APP_ENVIRONMENT=production

# RevenueCat Configuration (if using real RevenueCat)
# REACT_APP_REVENUECAT_API_KEY=your_revenuecat_api_key_here

# Application Insights (optional)
# REACT_APP_APPINSIGHTS_INSTRUMENTATIONKEY=your_app_insights_key_here

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true

# API Timeouts (in milliseconds)
REACT_APP_API_TIMEOUT=30000

# Debug Mode
REACT_APP_DEBUG=false